VERIDEX_CONTROL_PLANE_HOST=0.0.0.0
VERIDEX_CONTROL_PLANE_PORT=4010
VERIDEX_CONTROL_PLANE_STORAGE_BACKEND=file
VERIDEX_CONTROL_PLANE_DATA_DIR=./data/control-plane
VERIDEX_CONTROL_PLANE_AUTH_REQUIRED=true
VERIDEX_CONTROL_PLANE_TENANT_HEADER=x-veridex-tenant-id
VERIDEX_CONTROL_PLANE_BOOTSTRAP_TOKENS=["replace-me-with-a-long-random-token"]
VERIDEX_CONTROL_PLANE_APPROVAL_SWEEP_MS=30000
VERIDEX_CONTROL_PLANE_TRACE_PURGE_MS=900000
VERIDEX_CONTROL_PLANE_TRACE_RETENTION_DAYS=90
VERIDEX_CONTROL_PLANE_POSTGRES_URL=postgres://postgres:postgres@localhost:5432/veridex
VERIDEX_CONTROL_PLANE_POSTGRES_SSL=false
VERIDEX_CONTROL_PLANE_POSTGRES_METADATA_TABLE=veridex_control_plane_metadata
VERIDEX_CONTROL_PLANE_POSTGRES_TRACES_TABLE=veridex_control_plane_traces
