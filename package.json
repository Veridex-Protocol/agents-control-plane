{
  "name": "@veridex/agents-control-plane",
  "version": "0.1.3",
  "description": "Enterprise control plane SDK for the Veridex Agent Runtime — policy packs, trace retention, approval workflows, audit export, multi-tenant governance",
  "license": "MIT",
  "author": "Veridex Team",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "veridex-control-plane": "./dist/server-entry.mjs"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/server-entry.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "demo:server": "bun examples/demo-modexia/run-server.ts",
    "demo:client": "bun examples/demo-modexia/run-client.ts",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@veridex/agents": "0.1.3"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "pg": "^8.20.0"
  },
  "devDependencies": {
    "@veridex/agents": "0.1.3",
    "@types/node": "^20.11.24",
    "tsup": "^8.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.0"
  },
  "keywords": [
    "veridex",
    "agents",
    "control-plane",
    "enterprise",
    "policy",
    "audit",
    "governance"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Veridex-Protocol/agents-control-plane.git"
  },
  "homepage": "https://github.com/Veridex-Protocol/agents-control-plane#readme",
  "bugs": {
    "url": "https://github.com/Veridex-Protocol/agents-control-plane/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
